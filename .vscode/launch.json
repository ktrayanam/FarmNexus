{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌾 Run FastAPI Backend (Python)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend_python.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "5050",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "🌐 Run Streamlit Web App (Python)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/streamlit_app.py",
        "--server.port",
        "8501"
      ],
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "🧪 Run Python Test Suite (15/15)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend_python/test_suite.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
