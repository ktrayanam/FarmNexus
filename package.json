{
  "name": "farmnexus-workspace",
  "version": "2.0.0",
  "description": "FarmNexus - Python AI Platform for Smart Crop Care & Direct Market Access",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "cd backend && node test_suite.js",
    "build": "cd frontend && npm install && npm run build",
    "dev:py": "concurrently \"npm run dev:backend:py\" \"npm run dev:frontend\"",
    "dev:backend:py": "python3 -m uvicorn backend_python.main:app --port 5050 --reload",
    "dev:streamlit": "streamlit run streamlit_app.py --server.port 8501",
    "test:py": "python3 backend_python/test_suite.py",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.1",
    "express": "^4.21.2",
    "mongoose": "^9.10.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

