      "diseaseName": "Late Blight",
      "pathogen": "Phytophthora infestans (Oomycete)",
      "confidence": 0.94,
      "severity": "High",
      "symptoms": [
        "Irregular, dark, water-soaked brown lesions on leaves",
        "White fungal mold growth on underside of leaves in humid weather",
        "Firm, brown, leathery rot spreading across green and ripe tomatoes",
        "Rapid collapse of foliage mimicking frost burn"
      ],
      "organicTreatments": [
        "Spray Copper Oxychloride or Bordeaux mixture (1%) as protective barrier",
        "Apply Trichoderma viride bio-fungicide @ 5g/litre of water to root zone",
        "Spray Panchagavya (3% solution) + fermented butter-milk (10%) to inhibit spore germination",
        "Remove and safely burn infected plants; improve field drainage"
      ],
      "chemicalTreatments": [
        "Curative spray: Cymoxanil 8% + Mancozeb 64% WP (Curzate) @ 2.5g/litre",
        "Systemic control: Dimethomorph 50% WP @ 1g/litre OR Metalaxyl-M 4% + Mancozeb 64% WP (Ridomil Gold) @ 2g/litre",
        "Safety notes: Use gloves & mask; observe 7-day pre-harvest withholding interval (PHI)"
      ],
      "kvkHotline": "Krishi Vigyan Kendra Guntur: 1800-425-3535 (Kisan Call Centre 1551)"
    },
    {
      "id": "dis-02",
      "crop": "Chilli",
      "diseaseName": "Leaf Curl Virus (Chilli Murda)",
      "pathogen": "Chilli Leaf Curl Begomovirus (Vector: Whitefly Bemisia tabaci)",
      "confidence": 0.91,
      "severity": "Critical",
      "symptoms": [
        "Upward curling, puckering, and severe reduction of leaf size",
        "Thickening and shortening of petioles, severe plant stunting",
        "Crowded bushy appearance ('witch's broom') with minimal flowering",
        "Deformed small fruits with low seed set"
      ],
      "organicTreatments": [
        "Install 15 yellow sticky traps per acre to capture adult whiteflies",
        "Spray Neem Oil (Azadirachtin 10,000 ppm) @ 2.5 ml/litre every 7 days",
        "Apply Agniastra / Dashaparni Kashayam organic insect repellent spray",
        "Intercrop with border rows of maize or sorghum (3 rows) as physical vector barrier"
      ],
      "chemicalTreatments": [
        "Vector suppression: Diafenthiuron 50% WP (Pegasus) @ 1.25g/litre",
        "Systemic control: Acetamiprid 20% SP @ 0.3g/litre OR Spiromesifen 22.9% SC @ 1 ml/litre",
        "Safety notes: Rotate chemical classes to prevent whitefly resistance. Avoid spraying during peak bee activity (early morning)."
      ],
      "kvkHotline": "National Chilli Research Center / KVK: 1800-180-1551"
    },
